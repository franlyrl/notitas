# Copy this file to .env.production on the Oracle VM. Do not commit populated secrets.
# Generate APP_KEY with: php artisan key:generate --show
APP_KEY=
AUTH_ENABLED=true
APP_DOMAIN=
ACME_EMAIL=

# DuckDNS subdomain without .duckdns.org, plus the token from duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

DB_DATABASE=notitas
DB_USERNAME=notitas
DB_PASSWORD=
DB_ROOT_PASSWORD=

OWNER_NAME=Journal Owner
OWNER_EMAIL=
OWNER_PASSWORD=

# Google Cloud OAuth web client. Add this exact redirect URI in Google Cloud Console.
# In Google OAuth consent screen, publish the app to Production so refresh tokens
# do not expire after the 7-day testing-mode limit.
AUDIO_STORAGE_DRIVER=google_drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://YOUR_DOMAIN/integrations/google-drive/callback
GOOGLE_LOGIN_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback

# SMTP credentials for verification emails. A Gmail app password can be used.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Mi Journal